VITE_APP_ID=legal-os-web
# Set true for the Netlify / browser-only demo. Set false when pointing at a real API.
VITE_DEMO_MODE=true
# Optional origin of the Express API once servers are ready (no trailing slash).
# VITE_API_URL=https://api.example.com
OWNER_OPEN_ID=/superadmin
OWNER_EMAIL=superadmin@legalos.local
OWNER_NAME="Super Admin"
LOCAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required for server session signing.
JWT_SECRET=change-me-to-a-long-random-secret

# Required when running seed scripts or database-backed auth locally.
DATABASE_URL=mysql://user:password@host:3306/database
